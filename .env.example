# Настройки запуска и тестовый браузерный ключ карты для проверки проекта.

# Порты на хосте. Значения по умолчанию выбраны так, чтобы не конфликтовать с 8000/8001.
UI_HOST_PORT=8080
BACKEND_HOST_PORT=8010
ML_HOST_PORT=8011
NDTP_HOST_PORT=9201
EMULATOR_HOST_PORT=18080

# Модельный комплект из ml/pretrained (v8: ансамбль v6 + нулевой гейт; v6 — лучший подтверждённый score 0,90034).
MODEL_VERSION=v8
# Движок инференса: onnx (по умолчанию, проверка совпадения с CatBoost при старте) или catboost.
ML_RUNTIME=onnx

# Режим Backend: replay (исторический CSV) или ndtp (приём по TCP).
BACKEND_MODE=replay
BACKEND_SPLIT=test
# Пусто: replay использует points, ndtp работает автономно; true/false — явное переопределение.
BACKEND_USE_POINTS=
# Соглашение времени NDTP для демонстрации, timezone CSV не подтверждён.
BACKEND_NDTP_TIME_OFFSET_S=0
BACKEND_LABELS=/app/dataset/labels/labels_test.csv
BACKEND_REPLAY_SPEED=60
BACKEND_REPLAY_START=2026-01-06 08:00:00
BACKEND_PREDICT_INTERVAL_S=30
# Цвет текущего отклонения становится серым после 5 минут с последней GPS-оценки.
BACKEND_CURRENT_DEVIATION_MAX_AGE_S=300

# Журнал просмотра обоих NDTP-источников: 2 часа времени источника, до 7200 снимков,
# до 64 МиБ сжатых записей. Не связан с окном телеметрии для ML. Только текущий прогон.
BACKEND_VIEW_HISTORY_WINDOW_S=7200
BACKEND_VIEW_HISTORY_INTERVAL_S=1
BACKEND_VIEW_HISTORY_MAX_FRAMES=7200
BACKEND_VIEW_HISTORY_MAX_BYTES=67108864

# Сдвиг даты расписания на целые сутки (время суток не меняется).
# Пусто: replay — 0; ndtp — auto: дата плана подстраивается под дату первого пакета потока
# (эмулятор ставит текущее время при том же расписании). Явно: 0, auto или число секунд.
BACKEND_PLAN_SHIFT_S=

# Локальная панель демо: переключение источников сбрасывает текущий прогон.
BACKEND_DEMO_ENABLED=true
# При запуске Backend без Compose задайте адрес доступного эмулятора/приёмника:
# BACKEND_EMULATOR_URL=http://127.0.0.1:18080
# BACKEND_EMULATOR_TARGET_HOST=host.docker.internal

# Вход в пульт (по умолчанию выключен: локальный стенд без учётных записей).
# Формат: роль:имя:токен через «;». dispatcher — отмечает алерты и управляет источником,
# viewer — только просмотр. Токен ≥ 12 символов; в Git не добавлять.
# BACKEND_AUTH_USERS=dispatcher:Иванова И.:придумайте-длинный-токен;viewer:Табло:другой-токен
BACKEND_AUTH_USERS=

# Наш собственный NDTP-replayer (profile tools).
NDTP_REPLAY_SPEED=60
NDTP_REPLAY_START=2026-01-06 08:00:00
NDTP_REPLAY_DURATION=7200

# UID/GID для контейнера обучения, чтобы artifacts принадлежали текущему пользователю.
DOCKER_UID=1000
DOCKER_GID=1000

# Тестовый браузерный ключ Яндекс Карт опубликован для проверки проекта жюри.
# Dockerfile использует его по умолчанию; свой ключ можно задать в .env.
# Для Vite без Docker: переменная окружения или frontend/.env.local.
VITE_YANDEX_MAPS_API_KEY=050e0b7e-e127-4dfb-900e-f0931f0c7759
