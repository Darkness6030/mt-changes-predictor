# Скопировать в .env при необходимости. Секретов здесь нет и быть не должно.

# Порты на хосте. Значения по умолчанию выбраны так, чтобы не конфликтовать с 8000/8001.
UI_HOST_PORT=8080
BACKEND_HOST_PORT=8010
ML_HOST_PORT=8011
NDTP_HOST_PORT=9201
EMULATOR_HOST_PORT=18080

# Модельный комплект из ml/pretrained (v2 содержит вероятность опоздания).
MODEL_VERSION=v2

# Режим Backend: replay (исторический CSV) или ndtp (приём по TCP).
BACKEND_MODE=replay
BACKEND_SPLIT=test
# Пусто: replay использует points, ndtp работает автономно; true/false — явное переопределение.
BACKEND_USE_POINTS=
# Соглашение времени NDTP для демонстрации, timezone CSV не подтверждён.
BACKEND_NDTP_TIME_OFFSET_S=0
BACKEND_LABELS=/app/dataset/labels/labels_test.csv
BACKEND_REPLAY_SPEED=60
BACKEND_REPLAY_START=2026-01-06 08:00:00
BACKEND_PREDICT_INTERVAL_S=30

# Демонстрационный сдвиг плана для живого эмулятора: 0 или auto.
# auto выравнивает дату плана с текущей датой потока и всегда показывается в UI.
BACKEND_PLAN_SHIFT_S=0

# Наш собственный NDTP-replayer (profile tools).
NDTP_REPLAY_SPEED=60
NDTP_REPLAY_START=2026-01-06 08:00:00
NDTP_REPLAY_DURATION=7200

# UID/GID для контейнера обучения, чтобы artifacts принадлежали текущему пользователю.
DOCKER_UID=1000
DOCKER_GID=1000
